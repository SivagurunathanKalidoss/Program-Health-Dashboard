# Keep real credentials out of source control.
# Local dashboard/demo mode (safe default)
MOCK_MODE=true
PROJECT_ID=enterprise-it
INTEGRATION_TIMEOUT_SECONDS=15

# Live ServiceNow connection
SN_URL=https://yourinstance.service-now.com
SN_USER=dashboard-integration-user
SN_PASS=replace-with-secret

# Live Dynatrace connection
DT_URL=https://yourtenant.live.dynatrace.com
DT_TOKEN=replace-with-api-token
